# syntax=docker/dockerfile:1
#
# Taozhiyy 前端静态站镜像（主站 SPA，已含 /blog /build /projects 路由）。
# 构建上下文是仓库根目录（因为 main/ 的构建要读 blog/source/_posts、
# previews/project-gallery、shared/ai-assistant 这几处相对路径）：
#   docker build -f deploy/docker/Dockerfile.web -t taozhiyy-web .
#
# 构建逻辑直接复用仓库里的 tools/vercel-build.mjs，避免和它各写一份导致
# 行为不一致——该脚本负责 npm run build（Vite，把文章/建站日志/星空馆都打进
# main 的 SPA 包）+ 组装 out/ + 产物校验。

# ---------- 构建阶段 ----------
FROM node:22-bookworm-slim AS build

WORKDIR /build

# 先只拷贝依赖清单，利用 Docker 层缓存：依赖没变时跳过 npm ci。
COPY main/package.json main/package-lock.json ./main/
COPY previews/project-gallery/package.json previews/project-gallery/package-lock.json ./previews/project-gallery/

# main 的 Vite 构建会动态 import previews/project-gallery/src/*，
# 该目录下源码 import 的 three/lucide 要从它自己的 node_modules 解析
# （和 tools/build-project-gallery.mjs 里的做法一致，先装好依赖）。
RUN npm ci --prefix previews/project-gallery
RUN npm ci --prefix main

# 再拷贝源码（这些变了才需要重新跑 vite build）。
COPY main ./main
# 导航「你在哪里」面板直接 import endfield_menu/src/App.tsx，
# 裸导入由 main/vite.config.js 的 endfieldMenuDeps 插件重定向到 main/node_modules，
# 所以这里只需源码，不用单独装依赖。
COPY endfield_menu/src ./endfield_menu/src
COPY blog/source/_posts ./blog/source/_posts
COPY previews/project-gallery/src previews/project-gallery/src
COPY previews/project-gallery/public previews/project-gallery/public
COPY shared/ai-assistant ./shared/ai-assistant
COPY tools/vercel-build.mjs ./tools/vercel-build.mjs

# --skip-install：依赖上面已经装好，这里只做 vite build + 组装 out/ + 校验。
RUN node tools/vercel-build.mjs --skip-install

# ---------- 运行阶段 ----------
FROM nginx:alpine AS runtime

# SPA 路由回落、/api/ 反代到 api 服务、TLS server block 都在这份配置里。
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# out/ 直接就是 nginx 的静态根目录。
# vercel-build.mjs 把产物写到 <repo 根>/out，在这个构建阶段里是 /build/out。
COPY --from=build /build/out /usr/share/nginx/html

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/vercel-build.mjs",
  "outputDirectory": "out",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.miku.coffee/api/:path*"
    },
    {
      "source": "/((?!api|ai-assistant).*)",
      "destination": "/index.html"
    }
  ]
}

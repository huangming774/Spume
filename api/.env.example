ACG_API_ADDR=:8080
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres
AUTH_COOKIE_SECURE=false
SESSION_SECRET=replace-me
OWNER_EMAIL=owner@example.com
# 站长登录名：后台 /app 登录时输它代替邮箱（大小写不敏感）。
OWNER_LOGIN_NAME=admin
# 站长账号种子密码（启动时播种站长号用）。仅此用途不受 8 位下限约束。
AUTH_OWNER_PASSWORD=
OWNER_SECURITY_QUESTION=你现在的学号
OWNER_SECURITY_ANSWER=
ACG_ALLOWED_ORIGINS=https://www.miku.coffee,http://localhost:5173,http://127.0.0.1:5173
# AI 聊天（OpenAI 兼容 chat/completions）。可直接填 OpenRouter：
# DEEPSEEK_BASE_URL=https://openrouter.ai/api、DEEPSEEK_API_KEY=sk-or-v1-...，
# 模型每天自动轮换免费的，DEEPSEEK_MODEL 只是现检失败时的兜底。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# 文生图优先走 Cloudflare Workers AI（账号 ID 缺省复用 R2_ACCOUNT_ID）。
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_IMAGE_MODEL=z-image-turbo
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taozhiyy
R2_PUBLIC_BASE=https://fs.964643.xyz
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Zilliz Cloud 向量库（cloud.zilliz.com），站内搜索用 BM25 全文检索。
# ZILLIZ_URI 是集群公共端点，例如 https://xxxx.zillizcloud.com（不带末尾斜杠）。
ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION=taozhiyy_search
# QStash 调度。API 只读两个签名密钥；URL/TOKEN 是管理调度任务用的，可选。
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
ACG_PUBLIC_ORIGIN=https://www.miku.coffee
ACG_SESSION_TIMEOUT_MS=4000
ACG_DB_ACQUIRE_TIMEOUT_MS=10000
ACG_DB_STATEMENT_TIMEOUT_MS=15000
ACG_WEATHER_TIMEOUT_MS=4000
ACG_HEALTH_REFRESH_MS=15000
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
OWNER_PUBLISH_GITHUB_BRANCH=master
BILIBILI_UID=1061280173
RADAR_CREATORS=
MAIL_NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ACG_CONTENT_ROOT=
# 主留言区提交。不是 1/true/yes/on/enabled 就关闭，和 Go 一致。友链分区不受影响。
GUESTBOOK_MAIN_POSTS_ENABLED=1
SYNC_TRIGGER_TOKEN=
